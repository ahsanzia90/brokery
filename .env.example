# ---------------------------------------------------------------------------
# MandiLink / Pakistan Commodity Market — environment variables
# Copy to .env.local (development) or set in your hosting provider (production).
# Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL 14+) ---------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Optional: separate database used by `npm run test`
TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE_test

# --- Application -------------------------------------------------------------
# Public base URL used for canonical links, sitemaps and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Brand (can also be changed from Admin → Settings without redeploying)
NEXT_PUBLIC_BRAND_NAME=MandiLink
NEXT_PUBLIC_PRODUCT_NAME=Pakistan Commodity Market
NODE_ENV=development

# --- Security ----------------------------------------------------------------
# 32+ random bytes, base64 or hex. Used to HMAC one-time codes and sign cookies.
#   openssl rand -hex 32
AUTH_SECRET=replace-with-64-hex-characters
# Session lifetime in days
SESSION_TTL_DAYS=30

# --- OTP / SMS delivery ------------------------------------------------------
# console  → prints the code to the server log (development only, never production)
# twilio   → Twilio Verify-compatible SMS via TWILIO_* variables below
# http     → generic HTTP POST webhook (your SMS gateway); see docs/INTEGRATIONS.md
OTP_PROVIDER=console
OTP_CODE_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=

# --- Email (optional notifications) -----------------------------------------
# none | smtp
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="MandiLink <no-reply@example.com>"

# --- WhatsApp Business (optional; disabled until configured) -----------------
WHATSAPP_PROVIDER=none
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- File storage ------------------------------------------------------------
# local → files under STORAGE_LOCAL_ROOT (default ./storage). Private files are
#         only served through the authenticated /files route.
# s3    → any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Supabase Storage)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Max upload sizes (bytes)
MAX_IMAGE_BYTES=5242880
MAX_DOCUMENT_BYTES=10485760

# --- Analytics / monitoring (optional) ---------------------------------------
# Events are always recorded in the database. These forward them elsewhere.
ANALYTICS_PROVIDER=none
NEXT_PUBLIC_GA_MEASUREMENT_ID=
SENTRY_DSN=
# Google Search Console HTML verification token (rendered as a meta tag)
GOOGLE_SITE_VERIFICATION=

# --- Admin bootstrap ---------------------------------------------------------
# Used once by `npm run admin:create -- --phone +923001234567 --name "Admin"`
# No default admin is created automatically.

# --- Scheduled maintenance ---------------------------------------------------
# Shared secret for POST /api/cron (expires listings/RFQs/prices, sends queued notifications)
CRON_SECRET=
